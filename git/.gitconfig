[core]
  pager = delta

# This is Git's per-user configuration file.
[user]
  # Please adapt and uncomment the following lines:
  name = valdemarua
  email = valdemarua@users.noreply.github.com

[diff]
  # https://git-scm.com/docs/git-diff#Documentation/git-diff.txt-plain
	colorMoved = plain # color moved text shorter than 20 characters
  tool = vimdiff

[difftool]
  prompt = false

[merge]
  tool = vimdiff
  conflictstyle = zdiff3 # delta's configuration

[pull]
	rebase = true

[fetch]
	prune = true

# Short log lines. lg: hash, branches/tags, subject, relative date, author
# (glol/glola/glb). lo: hash, date, branches/tags, subject (glo).
[pretty]
  lg = tformat:%C(yellow)%h%C(reset)%C(auto)%d%C(reset) %s %C(green)(%ar) %C(blue)<%an>%C(reset)
  lo = tformat:%C(yellow)%h%C(reset) %C(green)%ad%C(reset)%C(auto)%d%C(reset) %s

[interactive]
  diffFilter = dilta --color-only

[delta]
  navigate = true # use n and N to move between diff sections
  dark = true
