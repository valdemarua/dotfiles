######
# Aliases
#####

# zsh
alias so="source ~/.zshrc"

# Common
alias cl=clear
alias -- -="cd -"
alias lsa="ls -lah"

# Tmux
alias th="tm humanize"

# Dirs
alias cdb="cd ~/Dropbox"
alias cdp="cd ~/Projects"
alias cds="cd ~/Sites"
alias cdd="cd ~/Downloads"
alias cda="cd ~/apps"
alias dtf="cd ~/dotfiles"

# Foreman
# alias fs="foreman start"
# alias fr="foreman run"
# alias fsp="foreman start -f Procfile.production"
# alias fsd="foreman start -f Procfile.dev"

# Overmind
alias os="overmind start"
alias osd="overmind s -f Procfile.dev"

# Bundler
alias bi="bundle install"
alias be="bundle exec"
alias bu="bundle update"

# Development
alias ra="bundle exec rubocop -a"
alias bs="bin/setup"
alias bw="bin/webpack-dev-server"
alias ss="spring stop"

alias rs="rails s"
alias rc="rails c"
alias rdm="rails db:migrate"
alias rdms="rails db:migrate:status"
alias rdr="rails db:rollback"
alias rT="rails -T"

# NPM
alias nrd="npm run dev"
alias nrl="npm run lint"

alias t="tree"

# VIM
alias v="vim"
alias vv="vim ."
alias vrc="vim ~/.vimrc"
alias vimrc="vim ~/.vimrc"
alias zrc="vim ~/.zshrc"
alias zshrc="vim ~/.zshrc"
# NVIM
alias nv="nvim"
alias n="nvim"
alias nvv="nvim ."
alias nn="nvim ."

# Search history
alias hg='history | grep'

# Git (`gcm`, `gcd` and `glb` are in .functions)
alias g='git'
alias gst='git status'
alias ga='git add'
alias gaa='git add --all'
alias gd='git diff'
alias gds='git diff --staged'
alias gb='git branch'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gc='git commit --verbose'
alias gcmsg='git commit --message'
alias gf='git fetch'
alias gp='git push'
alias gl='git pull'
alias glo='git log --pretty=lo --date=format-local:"%Y-%m-%d %H:%M"'
alias glog='git log --oneline --decorate --graph'
# `lo` and `lg` formats are defined in .gitconfig; `glb` (this branch only) is in .functions
alias glol='git log --graph --pretty=lg'
alias glola='git log --graph --pretty=lg --all'
alias glg='git log --stat'
alias grb='git rebase'
alias grhh='git reset --hard'
alias gsta='git stash push'
alias gstp='git stash pop'
# Single quotes delay $(...) until the alias runs, so it uses the branch you're
# on at that moment rather than the one active when the shell started.
alias ggl='git pull origin "$(git branch --show-current)"'
alias ggp='git push origin "$(git branch --show-current)"'

# Lazygit
alias lg='lazygit'

# mise
alias mi="mise install"
alias mls="mise ls"
