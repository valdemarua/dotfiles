# Development
alias ra="rubocop -a"
alias bs="bin/setup"
alias bw="bin/webpack-dev-server"
alias ss="spring stop"

alias rs="rails s"
alias rc="rails c"
alias rdm="rails db:migrate"
alias rdms="rails db:migrate:status"
alias rdr="rails db:rollback"
alias rT="rails -T"

# NPM
alias nrd="npm run dev"
alias nrl="npm run lint"

alias t="tree"

# Homebrew
# --global – Read the Brewfile from ~/.Brewfile
# ~/.Brewfile.local is machine-specific and gitignored — symlink from ~/.Brewfile.work or similar
bb() {
  local interrupted=false
  local global_status=0
  local local_status=0
  trap 'interrupted=true' INT  # catch Ctrl+C so we can stop gracefully

  brew bundle --global
  global_status=$?

  if $interrupted; then
    echo "brew bundle interrupted."
  elif [ $global_status -ne 0 ]; then
    echo "brew bundle --global failed; skipping ~/.Brewfile.local and brew cleanup." >&2
    trap - INT  # restore default SIGINT handler
    return $global_status
  else
    # install local/profile-specific packages if the file exists
    if [ -f ~/.Brewfile.local ]; then
      echo "~/.Brewfile.local found, installing local packages..."
      brew bundle --file ~/.Brewfile.local
      local_status=$?

      if [ $local_status -ne 0 ]; then
        echo "brew bundle --file ~/.Brewfile.local failed; skipping brew cleanup." >&2
        trap - INT  # restore default SIGINT handler
        return $local_status
      fi
    fi
  fi

  trap - INT  # restore default SIGINT handler
  $interrupted && return 1
  brew cleanup
}

# VIM
alias v="vim"
alias vv="vim ."
alias vrc="vim ~/.vimrc"
alias vimrc="vim ~/.vimrc"
alias zrc="vim ~/.zshrc"
alias zshrc="vim ~/.zshrc"
# NVIM
alias nv="nvim"
alias n="nvim"
alias nvv="nvim ."
alias nn="nvim ."

# Search history
alias hg='history | grep'

# Lazygit
alias lg='lazygit'
