# Tmux
tm() {
  tmux new-session -A -s "${1:-main}"
}

# SSH: Gruvbox Dark for the current pane while connected (local machine only)
# Uses OSC escape sequences, supported by Ghostty and WezTerm.
if [[ -z "$SSH_CONNECTION" ]]; then
  ssh() {
    local -a palette=(282828 cc241d 98971a d79921 458588 b16286 689d6a a89984
                      928374 fb4934 b8bb26 fabd2f 83a598 d3869b 8ec07c ebdbb2)
    local i
    for i in {0..15}; do printf '\e]4;%d;#%s\a' $i ${palette[i+1]}; done
    printf '\e]10;#ebdbb2\a\e]11;#282828\a\e]12;#ebdbb2\a'

    command ssh "$@"
    local ssh_status=$?

    printf '\e]104\a\e]110\a\e]111\a\e]112\a'  # restore the terminal's theme
    return $ssh_status
  }
fi

# Homebrew (macOS only)
if command -v brew >/dev/null 2>&1; then
  # --global – Read the Brewfile from ~/.Brewfile
  # ~/.Brewfile.local is machine-specific and gitignored — symlink from ~/.Brewfile.work or similar
  bb() {
    local interrupted=false
    local global_status=0
    local local_status=0
    trap 'interrupted=true' INT  # catch Ctrl+C so we can stop gracefully

    brew bundle --global --upgrade
    global_status=$?

    if $interrupted; then
      echo "brew bundle interrupted."
    elif [ $global_status -ne 0 ]; then
      echo "brew bundle --global failed; skipping ~/.Brewfile.local and brew cleanup." >&2
      trap - INT  # restore default SIGINT handler
      return $global_status
    else
      # Upgrade local/profile-specific packages if the file exists.
      if [ -f ~/.Brewfile.local ]; then
        echo "~/.Brewfile.local found, upgrading local packages..."
        brew bundle --file ~/.Brewfile.local --upgrade
        local_status=$?

        if [ $local_status -ne 0 ]; then
          echo "brew bundle --file ~/.Brewfile.local failed; skipping brew cleanup." >&2
          trap - INT  # restore default SIGINT handler
          return $local_status
        fi
      fi
    fi

    trap - INT  # restore default SIGINT handler
    $interrupted && return 1
    echo "Removing cached Homebrew downloads..."
    brew cleanup --prune=all
  }
fi

# mise
if command -v mise >/dev/null 2>&1; then
  mu() {
    mise self-update && mise upgrade --global
  }
fi

# Shell startup timing
timezsh() {
  shell=${1-$SHELL}
  for i in $(seq 1 10); do /usr/bin/time $shell -i -c exit; done
}
